+/* -----------------------------------------------------------------------
+ * External-signing support (MQTTClient_SSLOptions struct_version >= 6)
+ * When ssl_external_signing_method == 1 and ssl_external_sign_cb is set,
+ * a synthetic EC_KEY delegates CertificateVerify signing to the callback.
+ * The private key never touches the filesystem.
+ * OpenSSL 3.x marks EC_KEY_METHOD deprecated; suppress for this block.
+ * ----------------------------------------------------------------------- */
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wdeprecated-declarations"
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+#include <openssl/core_names.h>
+#endif
+typedef struct {
+	unsigned int (*sign_cb)(uint16_t algorithm,
+	                        const void *data, size_t data_len,
+	                        void *out, size_t max_out, size_t *out_len);
+	uint16_t algorithm;
+} ExtSignCtx;
+static int              ext_sign_ex_idx      = -1;
+/* ext_sign_ec_method and ext_ecdsa_sign removed: signing now intercepted at the
+ * EVP_PKEY_METHOD level (ext_digestsign) which receives the raw TLS context data
+ * BEFORE OpenSSL's SHA-256 step.  The TA's IBootStrap_SignDataWithECCKey hashes
+ * the input internally, so passing the pre-hash digest caused a double-hash
+ * mismatch and server rejection.  Passing raw data lets TA hash once → correct. */
+/* static EC_KEY_METHOD   *ext_sign_ec_method = NULL; */
+/* static int ext_ecdsa_sign(...) { ... } */
+
+/* ext_digestsign — registered as EVP_PKEY_METHOD->digestsign for EVP_PKEY_EC.
+ * Called by EVP_DigestSign() BEFORE the SHA-256 step.  'tbs' is the raw
+ * TLS 1.3 CertificateVerify context data (~98 bytes, not the 32-byte hash).
+ * TA computes SHA-256(tbs) internally → ECDSA(key, SHA-256(tbs)) = ECDSA(key, H)
+ * which matches what the TLS server verifies against. */
+static int ext_digestsign(EVP_MD_CTX *ctx,
+                           unsigned char *sig, size_t *siglen,
+                           const unsigned char *tbs, size_t tbslen)
+{
+	EVP_PKEY_CTX *pctx     = EVP_MD_CTX_get_pkey_ctx(ctx);
+	EVP_PKEY     *pkey     = pctx ? EVP_PKEY_CTX_get0_pkey(pctx) : NULL;
+	const EC_KEY *ec       = pkey ? EVP_PKEY_get0_EC_KEY(pkey) : NULL;
+	ExtSignCtx   *sign_ctx = NULL;
+	if (ec && ext_sign_ex_idx >= 0)
+		sign_ctx = (ExtSignCtx *)EC_KEY_get_ex_data(ec, ext_sign_ex_idx);
+	if (sign_ctx != NULL && sign_ctx->sign_cb != NULL) {
+		/* OpenSSL calls digestsign twice: first with sig=NULL to get the max
+		 * output size, then with a real buffer to sign.  Handle the size query. */
+		if (sig == NULL) {
+			*siglen = (size_t)ECDSA_size(ec);
+			return 1;
+		}
+		/* External signing: pass raw (unhashed) TLS context data to TA.
+		 * TA hashes with SHA-256 internally before ECDSA. */
+		size_t       out_len = *siglen;
+		unsigned int ret     = sign_ctx->sign_cb(sign_ctx->algorithm,
+		                                          tbs, tbslen,
+		                                          sig, *siglen, &out_len);
+		if (ret) *siglen = out_len;
+		return ret ? 1 : 0;
+	}
+	/* Fallback for non-external EC keys: hash then sign normally. */
+	{
+		unsigned char digest[32];
+		unsigned int  sig_u = (unsigned int)*siglen;
+		SHA256(tbs, tbslen, digest);
+		int ret = ECDSA_sign(0, digest, (int)sizeof(digest), sig, &sig_u, (EC_KEY *)(void *)ec);
+		if (ret == 1) *siglen = (size_t)sig_u;
+		return ret;
+	}
+}
+static EVP_PKEY_METHOD  *ext_sign_pkey_method = NULL;
+static void ext_sign_ctx_free_cb(void *parent, void *ptr, CRYPTO_EX_DATA *ad,
+                                  int idx, long argl, void *argp)
+{ (void)parent; (void)ad; (void)idx; (void)argl; (void)argp; free(ptr); }
+static EVP_PKEY *SSLSocket_makeExternalSignKey(SSL_CTX *ctx, ExtSignCtx *sign_ctx)
+{
+	X509     *cert    = NULL;
+	EVP_PKEY *pub     = NULL, *pkey = NULL;
+	EC_KEY   *ec_sign = NULL;
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+	/* OpenSSL 3.0: EVP_PKEY_get1_EC_KEY() returns NULL for provider-backed
+	 * keys (the default since 3.0).  Extract curve name and public-key
+	 * octets via the EVP_PKEY params API instead. */
+	unsigned char *pub_oct    = NULL;
+	size_t         pub_oct_len = 0;
+	EC_POINT      *pub_point  = NULL;
+	char           curve_name[64];
+	int            nid;
+#else
+	EC_KEY *ec_pub = NULL;
+#endif
+	if (ext_sign_ex_idx == -1) {
+		ext_sign_ex_idx = EC_KEY_get_ex_new_index(0,NULL,NULL,NULL,ext_sign_ctx_free_cb);
+		/* Register a custom EVP_PKEY_METHOD for EVP_PKEY_EC that hooks
+		 * EVP_DigestSign() before the SHA-256 step (digestsign callback).
+		 * Replaces the old EC_KEY_METHOD approach which received the post-hash
+		 * digest, causing the TA to double-hash and produce a wrong signature. */
+		/* if (ext_sign_ec_method == NULL) {
+		 *     ext_sign_ec_method = EC_KEY_METHOD_new(EC_KEY_get_default_method());
+		 *     EC_KEY_METHOD_set_sign(ext_sign_ec_method, ext_ecdsa_sign, NULL, NULL);
+		 * } */
+		if (ext_sign_pkey_method == NULL) {
+			const EVP_PKEY_METHOD *orig = EVP_PKEY_meth_find(EVP_PKEY_EC);
+			ext_sign_pkey_method = EVP_PKEY_meth_new(EVP_PKEY_EC, 0);
+			if (orig && ext_sign_pkey_method) {
+				EVP_PKEY_meth_copy(ext_sign_pkey_method, orig);
+				EVP_PKEY_meth_set_digestsign(ext_sign_pkey_method, ext_digestsign);
+				EVP_PKEY_meth_add0(ext_sign_pkey_method);
+			}
+		}
+	}
+	cert = SSL_CTX_get0_certificate(ctx); if (!cert) goto done;
+	pub  = X509_get_pubkey(cert);         if (!pub)  goto done;
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+	if (EVP_PKEY_get_utf8_string_param(pub, OSSL_PKEY_PARAM_GROUP_NAME,
+	                                   curve_name, sizeof(curve_name), NULL) != 1)
+		goto done;
+	nid = OBJ_txt2nid(curve_name);
+	if (nid == NID_undef) goto done;
+	ec_sign = EC_KEY_new_by_curve_name(nid); if (!ec_sign) goto done;
+	/* EC_KEY_set_method(ec_sign, ext_sign_ec_method); -- removed: signing now via
+	 * ext_sign_pkey_method->digestsign which intercepts before SHA-256. */
+	if (EVP_PKEY_get_octet_string_param(pub, OSSL_PKEY_PARAM_PUB_KEY,
+	                                    NULL, 0, &pub_oct_len) != 1) goto done;
+	pub_oct = (unsigned char *)malloc(pub_oct_len); if (!pub_oct) goto done;
+	if (EVP_PKEY_get_octet_string_param(pub, OSSL_PKEY_PARAM_PUB_KEY,
+	                                    pub_oct, pub_oct_len, &pub_oct_len) != 1)
+		goto done;
+	pub_point = EC_POINT_new(EC_KEY_get0_group(ec_sign)); if (!pub_point) goto done;
+	if (EC_POINT_oct2point(EC_KEY_get0_group(ec_sign), pub_point,
+	                       pub_oct, pub_oct_len, NULL) != 1) goto done;
+	if (EC_KEY_set_public_key(ec_sign, pub_point) != 1) goto done;
+#else
+	ec_pub = EVP_PKEY_get1_EC_KEY(pub); EVP_PKEY_free(pub); pub = NULL;
+	if (!ec_pub) goto done;
+	ec_sign = EC_KEY_new(); if (!ec_sign) goto done;
+	/* EC_KEY_set_method(ec_sign, ext_sign_ec_method); -- removed: see OpenSSL 3.0 branch above */
+	if (EC_KEY_set_group(ec_sign, EC_KEY_get0_group(ec_pub)) != 1) goto done;
+	if (EC_KEY_set_public_key(ec_sign, EC_KEY_get0_public_key(ec_pub)) != 1) goto done;
+	EC_KEY_free(ec_pub); ec_pub = NULL;
+#endif
+	/* Removed: dummy private key (BN=1) is no longer needed.  Signing is now
+	 * done via ext_sign_pkey_method->digestsign which intercepts EVP_DigestSign
+	 * before SHA-256, so pkey_ec_sign / EC_KEY_METHOD->sign are never called.
+	 * EC_KEY_set_method is also removed above — no EC_KEY_METHOD registered. */
+	/* {
+	 *     BIGNUM *dummy_d = BN_new();
+	 *     if (!dummy_d || !BN_set_word(dummy_d, 1) ||
+	 *         !EC_KEY_set_private_key(ec_sign, dummy_d)) {
+	 *         if (dummy_d) BN_free(dummy_d);
+	 *         goto done;
+	 *     }
+	 *     BN_free(dummy_d);
+	 * } */
+	EC_KEY_set_ex_data(ec_sign, ext_sign_ex_idx, sign_ctx);
+	pkey = EVP_PKEY_new(); if (!pkey) goto done;
+	EVP_PKEY_assign_EC_KEY(pkey, ec_sign); ec_sign = NULL;
+done:
+	if (pub)     EVP_PKEY_free(pub);
+	if (ec_sign) EC_KEY_free(ec_sign);
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+	if (pub_oct)   free(pub_oct);
+	if (pub_point) EC_POINT_free(pub_point);
+#else
+	if (ec_pub) EC_KEY_free(ec_pub);
+#endif
+	return pkey;
+}
+#pragma GCC diagnostic pop
+/* ----------------------------------------------------------------------- */
 int SSLSocket_createContext(networkHandles* net, MQTTClient_SSLOptions* opts)
 {
 	int rc = 1;
@@ -593,9 +763,11 @@ int SSLSocket_createContext(networkHandles* net, MQTTClient_SSLOptions* opts)
 		}
 	}
 
+/*
 #if (OPENSSL_VERSION_NUMBER >= 0x10100000L)
 	SSL_CTX_set_security_level(net->ctx, 1);
 #endif
+*/
 
 	if (opts->keyStore)
 	{
@@ -608,26 +780,59 @@ int SSLSocket_createContext(networkHandles* net, MQTTClient_SSLOptions* opts)
 			goto free_ctx; /*If we can't load the certificate (chain) file then loading the privatekey won't work either as it needs a matching cert already loaded */
 		}
 
-		if (opts->privateKey == NULL)
-			opts->privateKey = opts->keyStore;   /* the privateKey can be included in the keyStore */
-
-		if (opts->privateKeyPassword != NULL)
+			/* External-signing path: private key lives in the TA, not on disk.
+		 * A synthetic EC_KEY delegates signing to ssl_external_sign_cb. */
+		if (opts->struct_version >= 6 &&
+		    opts->ssl_external_signing_method &&
+		    opts->ssl_external_sign_cb)
 		{
-			SSL_CTX_set_default_passwd_cb(net->ctx, pem_passwd_cb);
-			SSL_CTX_set_default_passwd_cb_userdata(net->ctx, (void*)opts->privateKeyPassword);
+			ExtSignCtx *sign_ctx = (ExtSignCtx *)malloc(sizeof(ExtSignCtx));
+			EVP_PKEY   *ext_pkey = NULL;
+			if (!sign_ctx) {
+				rc = 0;
+				SSLSocket_error("malloc ExtSignCtx", NULL, net->socket, rc,
+				                opts->ssl_error_cb, opts->ssl_error_context);
+				goto free_ctx;
+			}
+			sign_ctx->sign_cb   = opts->ssl_external_sign_cb;
+			sign_ctx->algorithm = opts->ssl_external_signing_algorithm;
+			ext_pkey = SSLSocket_makeExternalSignKey(net->ctx, sign_ctx);
+			if (!ext_pkey) {
+				free(sign_ctx); rc = 0;
+				SSLSocket_error("SSLSocket_makeExternalSignKey", NULL, net->socket, rc,
+				                opts->ssl_error_cb, opts->ssl_error_context);
+				goto free_ctx;
+			}
+			rc = SSL_CTX_use_PrivateKey(net->ctx, ext_pkey);
+			EVP_PKEY_free(ext_pkey);
+			if (rc != 1) {
+				SSLSocket_error("SSL_CTX_use_PrivateKey (external signing)", NULL,
+				                net->socket, rc,
+				                opts->ssl_error_cb, opts->ssl_error_context);
+				goto free_ctx;
+			}
 		}
-
-		/* support for ASN.1 == DER format? DER can contain only one certificate? */
-		rc = SSL_CTX_use_PrivateKey_file(net->ctx, opts->privateKey, SSL_FILETYPE_PEM);
-		if (opts->privateKey == opts->keyStore)
-			opts->privateKey = NULL;
-		if (rc != 1)
+		else
 		{
-			if (opts->struct_version >= 3)
-				SSLSocket_error("SSL_CTX_use_PrivateKey_file", NULL, net->socket, rc, opts->ssl_error_cb, opts->ssl_error_context);
-			else
-				SSLSocket_error("SSL_CTX_use_PrivateKey_file", NULL, net->socket, rc, NULL, NULL);
-			goto free_ctx;
+			/* Standard path: load private key from PEM file. */
+			if (opts->privateKey == NULL)
+				opts->privateKey = opts->keyStore; /* key may be in keyStore */
+			if (opts->privateKeyPassword != NULL) {
+				SSL_CTX_set_default_passwd_cb(net->ctx, pem_passwd_cb);
+				SSL_CTX_set_default_passwd_cb_userdata(net->ctx, (void*)opts->privateKeyPassword);
+			}
+			rc = SSL_CTX_use_PrivateKey_file(net->ctx, opts->privateKey, SSL_FILETYPE_PEM);
+			if (opts->privateKey == opts->keyStore)
+				opts->privateKey = NULL;
+			if (rc != 1) {
+				if (opts->struct_version >= 3)
+					SSLSocket_error("SSL_CTX_use_PrivateKey_file", NULL, net->socket, rc,
+					                opts->ssl_error_cb, opts->ssl_error_context);
+				else
+					SSLSocket_error("SSL_CTX_use_PrivateKey_file", NULL, net->socket, rc,
+					                NULL, NULL);
+				goto free_ctx;
+			}
 		}
 	}
 
