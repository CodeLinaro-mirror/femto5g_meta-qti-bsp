+#if defined(OPENSSL)
+/* -----------------------------------------------------------------------
+ * SSL handshake completion thread (external-signing deadlock fix)
+ *
+ * When ssl_external_sign_cb is registered the TLS CertificateVerify step
+ * calls signfxn() → cusp_a2a_send_recv() → sem_timedwait().  The A2A
+ * MQTT response is delivered by on_message_arrived(), which is dispatched
+ * by this very MQTTClient_run background thread — causing a single-thread
+ * self-deadlock.
+ *
+ * Fix: when SSL_IN_PROGRESS is detected and external signing is configured,
+ * spawn ssl_handshake_thread() to complete the TLS handshake.  The
+ * background thread remains free to loop through MQTTClient_cycle and
+ * deliver the A2A response that unblocks the signing callback.
+ * ----------------------------------------------------------------------- */
+typedef struct SSLCompleteArgs
+{
+	MQTTClients *m;
+	int          sslopts_version;
+	int          verify;
+	const char  *serverURI;
+	int          (*ssl_error_cb)(const char *str, size_t len, void *u);
+	void         *ssl_error_context;
+} SSLCompleteArgs;
+
+static thread_return_type WINAPI ssl_handshake_thread(void *arg)
+{
+	SSLCompleteArgs *a  = (SSLCompleteArgs *)arg;
+	MQTTClients     *m  = a->m;
+	int rc;
+
+	FUNC_ENTRY;
+
+	/* Bug 4 fix: a non-blocking socket may require multiple SSL_connect()
+	 * iterations.  The sign callback blocks inside SSL_connect() for up to
+	 * CUSP_A2A_TIMEOUT_MS (~30 s).  After the callback returns, SSL_connect()
+	 * needs another round-trip to read the server's Finished message, which
+	 * returns TCPSOCKET_INTERRUPTED on a non-blocking socket.  The previous
+	 * code treated TCPSOCKET_INTERRUPTED as a fatal error and posted
+	 * SSL_FATAL, causing every TA-signed reconnect to fail after signing.
+	 *
+	 * Fix: loop retrying SSLSocket_connect() with poll() between retries.
+	 * ssl_handshake_thread owns the SSL* object throughout; the background
+	 * MQTTClient_run thread detects SSL_THREAD_IN_PROGRESS and skips
+	 * MQTTPacket_Factory for this socket, so there is no concurrent SSL* use.
+	 * Total budget: 65 s (30 s A2A sign + TLS round-trips + margin). */
+	{
+		START_TIME_TYPE handshake_start = MQTTTime_start_clock();
+#define SSL_HANDSHAKE_TOTAL_MS 65000L
+		while (1)
+		{
+			rc = (a->sslopts_version >= 3) ?
+				SSLSocket_connect(m->c->net.ssl, m->c->net.socket, a->serverURI,
+				                  a->verify, a->ssl_error_cb, a->ssl_error_context) :
+				SSLSocket_connect(m->c->net.ssl, m->c->net.socket, a->serverURI,
+				                  a->verify, NULL, NULL);
+
+			if (rc != TCPSOCKET_INTERRUPTED)
+				break; /* success (1), fatal error, or truly unexpected rc */
+
+			/* Non-blocking socket needs more I/O; wait then retry. */
+			{
+				long remaining_ms = SSL_HANDSHAKE_TOTAL_MS - (long)MQTTTime_elapsed(handshake_start);
+				if (remaining_ms <= 0)
+				{
+					Log(TRACE_MIN, -1,
+					    "ssl_handshake_thread: handshake timeout for %s",
+					    m->c->clientID);
+					rc = SSL_FATAL;
+					break;
+				}
+				struct pollfd pfd;
+				pfd.fd      = m->c->net.socket;
+				pfd.events  = POLLIN | POLLOUT;
+				pfd.revents = 0;
+				int poll_ms = (remaining_ms > 5000L) ? 5000 : (int)remaining_ms;
+				int prc = poll(&pfd, 1, poll_ms);
+				if (prc <= 0 || (pfd.revents & (POLLERR | POLLHUP | POLLNVAL)))
+				{
+					Log(TRACE_MIN, -1,
+					    "ssl_handshake_thread: poll error/timeout for %s (prc=%d revents=0x%x)",
+					    m->c->clientID, prc, (unsigned)pfd.revents);
+					rc = SSL_FATAL;
+					break;
+				}
+				/* socket ready — retry SSL_connect */
+			}
+		}
+#undef SSL_HANDSHAKE_TOTAL_MS
+	}
+
+	free(a);
+
+	if (rc == 1 || rc == SSL_FATAL)
+	{
+		if (rc == 1 &&
+		    (m->c->cleansession == 0 && m->c->cleanstart == 0) &&
+		    m->c->session == NULL)
+			m->c->session = SSL_get1_session(m->c->net.ssl);
+		m->rc = rc;
+		Log(TRACE_MIN, -1, "ssl_handshake_thread: posting connect_sem for %s rc %d",
+		    m->c->clientID, m->rc);
+		/* Do NOT set connect_state = NOT_IN_PROGRESS before posting.
+		 * Leave connect_state as SSL_THREAD_IN_PROGRESS so the background
+		 * MQTTClient_cycle thread continues to skip MQTTPacket_Factory for
+		 * this socket. The connect thread will set WAIT_FOR_CONNACK after
+		 * waking, then the background thread reads CONNACK normally. */
+		Thread_post_sem(m->connect_sem);
+	}
+	else
+	{
+		/* Should not be reached after the loop above, but handle defensively. */
+		Log(TRACE_MIN, -1, "ssl_handshake_thread: unexpected rc %d for %s — posting connect_sem with SSL_FATAL",
+		    rc, m->c->clientID);
+		m->rc = SSL_FATAL;
+		Thread_post_sem(m->connect_sem);
+	}
+	FUNC_EXIT;
+	return 0;
+}
+#endif /* defined(OPENSSL) */
