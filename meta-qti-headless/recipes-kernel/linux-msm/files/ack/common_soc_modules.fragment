# common_soc_modules.fragment
#
# CONFIG entries for all modules compiled by soc-modules_6.12.bb OOT build,
# mirroring Bazel DDK where soc-repo owns all .ko targets.
#
# These CONFIGs are removed from autogvm-defconfig.config (ACK kernel build)
# and placed here so they are applied via auto.conf.soc to the soc-repo OOT
# make build (make -C KBA M=soc-repo/).
#
# ACK-sourced modules (source copied from common/ by copy_common_sources()):
#   CONFIG_CFG80211        -> common/net/wireless/
#   CONFIG_FAILOVER        -> common/net/core/failover.c
#   CONFIG_I2C_VIRTIO      -> common/drivers/i2c/busses/i2c-virtio.c
#   CONFIG_NET_FAILOVER    -> common/drivers/net/net_failover.c
#   CONFIG_VIRTIO_CONSOLE  -> common/drivers/char/virtio_console.c
#   CONFIG_VIRTIO_INPUT    -> common/drivers/virtio/virtio_input.c
#   CONFIG_VIRTIO_NET      -> common/drivers/net/virtio_net.c
#
# soc-repo native modules (source in soc-repo/):
#   All remaining =m entries below

# ACK-sourced modules
CONFIG_CFG80211=m
CONFIG_FAILOVER=m
CONFIG_I2C_VIRTIO=m
CONFIG_NET_FAILOVER=m
CONFIG_VIRTIO_CONSOLE=m
CONFIG_VIRTIO_INPUT=m
CONFIG_VIRTIO_NET=m

# soc-repo modules
