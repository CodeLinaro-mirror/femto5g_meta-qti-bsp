[Unit]
Description=QSFP28 25G client port bring-up (eth00)
Documentation=man:ip(8) man:ethtool(8)
After=network-pre.target systemd-networkd.service
Wants=network-pre.target
Before=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/qsfp-client-up.sh up
ExecStop=/usr/sbin/qsfp-client-up.sh down
TimeoutStartSec=90
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target
