[Unit]
Description=Report user-initiated restart cause to Fault Manager
DefaultDependencies=no
After=faultmgr.service
Before=umount.target reboot.target

[Service]
Type=oneshot
TimeoutStartSec=10s
ExecStart=/bin/sh -c 'set -eu; ts=$(/bin/date +%%s); exec /usr/bin/faultdbg -e RESTART_CAUSE_QMI_SET -C 255 -S 6 -B 0 -T "$((ts * 1000))"'

[Install]
WantedBy=reboot.target
