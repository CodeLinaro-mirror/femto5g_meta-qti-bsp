[Unit]
Description=dsp remoteproc start service
Requires=firmware-mount.service
After=sysinit.target systemd-modules-load.service firmware-mount.service
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/dsp_remoteproc_start.sh

[Install]
WantedBy=multi-user.target
