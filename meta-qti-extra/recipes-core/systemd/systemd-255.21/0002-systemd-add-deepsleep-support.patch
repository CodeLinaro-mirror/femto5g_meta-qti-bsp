From b81098e7dd1ac4e439aa8a127317cee317496c79 Mon Sep 17 00:00:00 2001
From: Kaisheng Yang <quic_kaisheng@quicinc.com>
Date: Mon, 27 Feb 2023 17:00:13 +0800
Subject: [PATCH] systemd: add deepsleep support

Add new sleep state deepsleep. Run systemctl deepsleep
to enter deepsleep state.

Upstream-Status: Pending

Change-Id: Ibaf87175aceb26507b52fb2da7e5620e29d29c84
Signed-off-by: Kaisheng Yang <quic_kaisheng@quicinc.com>
---
 man/systemctl.xml                       | 10 ++++++++
 man/systemd-suspend.service.xml         |  4 ++++
 man/systemd.special.xml                 |  9 +++++++
 src/basic/special.h                     |  1 +
 src/login/logind-action.c               |  5 ++++
 src/login/logind-action.h               |  1 +
 src/login/logind-dbus.c                 | 25 +++++++++++++++++++
 src/login/org.freedesktop.login1.policy | 32 +++++++++++++++++++++++++
 src/shared/sleep-config.c               | 15 ++++++++++--
 src/shared/sleep-config.h               |  1 +
 src/sleep/sleep.c                       |  1 +
 src/sleep/sleep.conf                    |  3 +++
 src/systemctl/systemctl-logind.c        |  1 +
 src/systemctl/systemctl-start-special.c |  1 +
 src/systemctl/systemctl-start-unit.c    |  1 +
 src/systemctl/systemctl.c               |  3 +++
 src/systemctl/systemctl.h               |  1 +
 units/deepsleep.target                  | 16 +++++++++++++
 units/meson.build                       |  2 ++
 units/systemd-deepsleep.service.in      | 19 +++++++++++++++
 20 files changed, 149 insertions(+), 2 deletions(-)
 create mode 100644 units/deepsleep.target
 create mode 100644 units/systemd-deepsleep.service.in

diff --git a/man/systemctl.xml b/man/systemctl.xml
index 1c14909523..85044f7394 100644
--- a/man/systemctl.xml
+++ b/man/systemctl.xml
@@ -1521,6 +1521,16 @@ Jan 12 10:46:45 example.com bluetoothd[8900]: gatt-time-server: Input/output err
           </listitem>
         </varlistentry>

+        <varlistentry>
+          <term><command>deepsleep</command></term>
+
+          <listitem>
+            <para>Deepsleep the system. This will trigger activation of the special target unit
+            <filename>deepsleep.target</filename>. This command is asynchronous, and will return after the deepsleep
+            operation is successfully enqueued. It will not wait for the deepsleep/resume cycle to complete.</para>
+          </listitem>
+        </varlistentry>
+
         <varlistentry>
           <term><command>hibernate</command></term>

diff --git a/man/systemd-suspend.service.xml b/man/systemd-suspend.service.xml
index 29249365a0..0f4dee3213 100644
--- a/man/systemd-suspend.service.xml
+++ b/man/systemd-suspend.service.xml
@@ -39,6 +39,9 @@
     <para><filename>systemd-suspend.service</filename> is a system
     service that is pulled in by <filename>suspend.target</filename>
     and is responsible for the actual system suspend. Similarly,
+    <filename>systemd-deepsleep.service</filename> is pulled in by
+    <filename>deepsleep.target</filename> to execute the actual
+    hibernation. Finally,
     <filename>systemd-hibernate.service</filename> is pulled in by
     <filename>hibernate.target</filename> to execute the actual
     hibernation. Finally,
@@ -102,6 +105,7 @@

       <varlistentry>
         <term><option>suspend</option></term>
+        <term><option>deepsleep</option></term>
         <term><option>hibernate</option></term>
         <term><option>suspend-then-hibernate</option></term>
         <term><option>hybrid-sleep</option></term>
diff --git a/man/systemd.special.xml b/man/systemd.special.xml
index 9eb0b4a2c2..5628512f29 100644
--- a/man/systemd.special.xml
+++ b/man/systemd.special.xml
@@ -83,6 +83,7 @@
     <filename>sockets.target</filename>,
     <filename>sound.target</filename>,
     <filename>suspend.target</filename>,
+    <filename>deepsleep.target</filename>,
     <filename>swap.target</filename>,
     <filename>sysinit.target</filename>,
     <filename>system-update.target</filename>,
@@ -231,6 +232,13 @@
             <citerefentry><refentrytitle>systemd</refentrytitle><manvolnum>1</manvolnum></citerefentry>.</para>
           </listitem>
         </varlistentry>
+        <varlistentry>
+          <term><filename>deepsleep.target</filename></term>
+          <listitem>
+            <para>A special target unit for deepsleep the system. This
+            pulls in <filename>deepsleep.target</filename>.</para>
+          </listitem>
+        </varlistentry>
         <varlistentry>
           <term><filename>display-manager.service</filename></term>
           <listitem>
@@ -669,6 +677,7 @@
           <listitem>
             <para>A special target unit that is pulled in by
             <filename>suspend.target</filename>,
+            <filename>deepsleep.target</filename> and
             <filename>hibernate.target</filename> and
             <filename>hybrid-sleep.target</filename> and may be used to
             hook units into the sleep state logic.</para>
diff --git a/src/basic/special.h b/src/basic/special.h
index 5d1111fd71..c2ae6f63bb 100644
--- a/src/basic/special.h
+++ b/src/basic/special.h
@@ -17,6 +17,7 @@
 #define SPECIAL_KEXEC_TARGET "kexec.target"
 #define SPECIAL_EXIT_TARGET "exit.target"
 #define SPECIAL_SUSPEND_TARGET "suspend.target"
+#define SPECIAL_DEEPSLEEP_TARGET "deepsleep.target"
 #define SPECIAL_HIBERNATE_TARGET "hibernate.target"
 #define SPECIAL_HYBRID_SLEEP_TARGET "hybrid-sleep.target"
 #define SPECIAL_SUSPEND_THEN_HIBERNATE_TARGET "suspend-then-hibernate.target"
diff --git a/src/login/logind-action.c b/src/login/logind-action.c
index e172910948..02da5b82e2 100644
--- a/src/login/logind-action.c
+++ b/src/login/logind-action.c
@@ -24,6 +24,7 @@ const char* manager_target_for_action(HandleAction handle) {
                 [HANDLE_HALT] = SPECIAL_HALT_TARGET,
                 [HANDLE_KEXEC] = SPECIAL_KEXEC_TARGET,
                 [HANDLE_SUSPEND] = SPECIAL_SUSPEND_TARGET,
+                [HANDLE_DEEPSLEEP] = SPECIAL_DEEPSLEEP_TARGET,
                 [HANDLE_HIBERNATE] = SPECIAL_HIBERNATE_TARGET,
                 [HANDLE_HYBRID_SLEEP] = SPECIAL_HYBRID_SLEEP_TARGET,
                 [HANDLE_SUSPEND_THEN_HIBERNATE] = SPECIAL_SUSPEND_THEN_HIBERNATE_TARGET,
@@ -49,6 +50,7 @@ int manager_handle_action(
                 [HANDLE_HALT] = "Halting...",
                 [HANDLE_KEXEC] = "Rebooting via kexec...",
                 [HANDLE_SUSPEND] = "Suspending...",
+                [HANDLE_DEEPSLEEP] = "Deepsleeping...",
                 [HANDLE_HIBERNATE] = "Hibernating...",
                 [HANDLE_HYBRID_SLEEP] = "Hibernating and suspending...",
                 [HANDLE_SUSPEND_THEN_HIBERNATE] = "Suspending, then hibernating...",
@@ -105,6 +107,8 @@ int manager_handle_action(

         if (handle == HANDLE_SUSPEND)
                 supported = can_sleep(SLEEP_SUSPEND) > 0;
+        if (handle == HANDLE_DEEPSLEEP)
+                supported = can_sleep(SLEEP_DEEPSLEEP) > 0;
         else if (handle == HANDLE_HIBERNATE)
                 supported = can_sleep(SLEEP_HIBERNATE) > 0;
         else if (handle == HANDLE_HYBRID_SLEEP)
@@ -178,6 +182,7 @@ static const char* const handle_action_table[_HANDLE_ACTION_MAX] = {
         [HANDLE_HALT] = "halt",
         [HANDLE_KEXEC] = "kexec",
         [HANDLE_SUSPEND] = "suspend",
+        [HANDLE_DEEPSLEEP] = "deepsleep",
         [HANDLE_HIBERNATE] = "hibernate",
         [HANDLE_HYBRID_SLEEP] = "hybrid-sleep",
         [HANDLE_SUSPEND_THEN_HIBERNATE] = "suspend-then-hibernate",
diff --git a/src/login/logind-action.h b/src/login/logind-action.h
index ec2fece2b7..eaa84d39e3 100644
--- a/src/login/logind-action.h
+++ b/src/login/logind-action.h
@@ -10,6 +10,7 @@ typedef enum HandleAction {
         HANDLE_HALT,
         HANDLE_KEXEC,
         HANDLE_SUSPEND,
+        HANDLE_DEEPSLEEP,
         HANDLE_HIBERNATE,
         HANDLE_HYBRID_SLEEP,
         HANDLE_SUSPEND_THEN_HIBERNATE,
diff --git a/src/login/logind-dbus.c b/src/login/logind-dbus.c
index c05c0d02cc..c9ea747c37 100644
--- a/src/login/logind-dbus.c
+++ b/src/login/logind-dbus.c
@@ -1989,6 +1989,21 @@ static int method_suspend(sd_bus_message *message, void *userdata, sd_bus_error
                         error);
 }

+static int method_deepsleep(sd_bus_message *message, void *userdata, sd_bus_error *error) {
+        Manager *m = userdata;
+
+        return method_do_shutdown_or_sleep(
+                        m, message,
+                        SPECIAL_DEEPSLEEP_TARGET,
+                        INHIBIT_SLEEP,
+                        "org.freedesktop.login1.deepsleep",
+                        "org.freedesktop.login1.deepsleep-multiple-sessions",
+                        "org.freedesktop.login1.deepslepp-ignore-inhibit",
+                        SLEEP_DEEPSLEEP,
+                        sd_bus_message_is_method_call(message, NULL, "DeepsleepWithFlags"),
+                        error);
+}
+
 static int method_hibernate(sd_bus_message *message, void *userdata, sd_bus_error *error) {
         Manager *m = userdata;

@@ -3575,6 +3590,16 @@ static const sd_bus_vtable manager_vtable[] = {
                                 SD_BUS_NO_RESULT,
                                 method_suspend,
                                 SD_BUS_VTABLE_UNPRIVILEGED),
+        SD_BUS_METHOD_WITH_ARGS("Deepsleep",
+                                SD_BUS_ARGS("b", interactive),
+                                SD_BUS_NO_RESULT,
+                                method_deepsleep,
+                                SD_BUS_VTABLE_UNPRIVILEGED),
+        SD_BUS_METHOD_WITH_ARGS("DeepsleepWithFlags",
+                                SD_BUS_ARGS("t", flags),
+                                SD_BUS_NO_RESULT,
+                                method_deepsleep,
+                                SD_BUS_VTABLE_UNPRIVILEGED),
         SD_BUS_METHOD_WITH_ARGS("Hibernate",
                                 SD_BUS_ARGS("b", interactive),
                                 SD_BUS_NO_RESULT,
diff --git a/src/login/org.freedesktop.login1.policy b/src/login/org.freedesktop.login1.policy
index df906b0e73..d209ddfd11 100644
--- a/src/login/org.freedesktop.login1.policy
+++ b/src/login/org.freedesktop.login1.policy
@@ -296,6 +296,38 @@
                 <annotate key="org.freedesktop.policykit.imply">org.freedesktop.login1.suspend</annotate>
         </action>

+        <action id="org.freedesktop.login1.deepsleep">
+                <description gettext-domain="systemd">DeepSleep the system</description>
+                <message gettext-domain="systemd">Authentication is required to deepsleep the system.</message>
+                <defaults>
+                        <allow_any>auth_admin_keep</allow_any>
+                        <allow_inactive>auth_admin_keep</allow_inactive>
+                        <allow_active>yes</allow_active>
+                </defaults>
+        </action>
+
+        <action id="org.freedesktop.login1.deepsleep-multiple-sessions">
+                <description gettext-domain="systemd">Deepsleep the system while other users are logged in</description>
+                <message gettext-domain="systemd">Authentication is required to deepsleep the system while other users are logged in.</message>
+                <defaults>
+                        <allow_any>auth_admin_keep</allow_any>
+                        <allow_inactive>auth_admin_keep</allow_inactive>
+                        <allow_active>yes</allow_active>
+                </defaults>
+                <annotate key="org.freedesktop.policykit.imply">org.freedesktop.login1.suspend</annotate>
+        </action>
+
+        <action id="org.freedesktop.login1.deepslepp-ignore-inhibit">
+                <description gettext-domain="systemd">Deepsleep the system while an application is inhibiting this</description>
+                <message gettext-domain="systemd">Authentication is required to deepsleep the system while an application is inhibiting this.</message>
+                <defaults>
+                        <allow_any>auth_admin_keep</allow_any>
+                        <allow_inactive>auth_admin_keep</allow_inactive>
+                        <allow_active>auth_admin_keep</allow_active>
+                </defaults>
+                <annotate key="org.freedesktop.policykit.imply">org.freedesktop.login1.suspend</annotate>
+        </action>
+
         <action id="org.freedesktop.login1.hibernate">
                 <description gettext-domain="systemd">Hibernate the system</description>
                 <message gettext-domain="systemd">Authentication is required to hibernate the system.</message>
