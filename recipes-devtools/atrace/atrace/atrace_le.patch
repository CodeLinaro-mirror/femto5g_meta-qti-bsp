Upstream-Status: Inappropriate [Qualcomm LE build integration]

From a218b23e7b8f955fe79f2c9f57541d69015b4999 Mon Sep 17 00:00:00 2001
From: Rakesh kumar <quic_rakk@quicinc.com>
Date: Mon, 11 Jul 2022 17:09:02 +0530
Subject: [PATCH] Enabling atrace tool

Porting of atrace tool from Andrdoid-11 to LE.

Change-Id: I32305f8f4c5cca8784ea999f26fc7ad45b9a60c3
---
 cmds/atrace/atrace.cpp | 132 ++++++++++++++++++++++++++++++++++++++---
 1 file changed, 124 insertions(+), 8 deletions(-)

diff --git a/cmds/atrace/atrace.cpp b/cmds/atrace/atrace.cpp
index 28fdaa4306..4b5ce3cb1a 100644
--- a/cmds/atrace/atrace.cpp
+++ b/cmds/atrace/atrace.cpp
@@ -14,7 +14,12 @@
  * limitations under the License.
  */
 
-#define LOG_TAG "atrace"
+/*
+ * Changes from Qualcomm Innovation Center are provided under the following license:
+ *
+ * Copyright (c) 2022 Qualcomm Innovation Center, Inc. All rights reserved.
+ * SPDX-License-Identifier: BSD-3-Clause-Clear
+*/
 
 #include <errno.h>
 #include <fcntl.h>
@@ -33,6 +38,13 @@
 #include <fstream>
 #include <memory>
 
+/* This version of atarce is from QSSI.11.0 and ported to LE platform
+*  some featutes that can not be made available on LE and controlled
+*  with BUILD_WITH_ANDROID flag, e.g set/get property api's and
+*  connecting to atarce service etc.
+*/
+
+#ifdef BUILD_WITH_ANDROID
 #include <binder/IBinder.h>
 #include <binder/IServiceManager.h>
 #include <binder/Parcel.h>
@@ -59,6 +71,25 @@ using hardware::Return;
 using hardware::atrace::V1_0::IAtraceDevice;
 using hardware::atrace::V1_0::Status;
 using hardware::atrace::V1_0::toString;
+#else
+#define LOG_TAG "atrace"
+#include <cutils/compiler.h>
+#include <cutils/properties.h>
+#include <utils/String8.h>
+#include <utils/Timers.h>
+#include <utils/Tokenizer.h>
+#include <cutils/trace.h>
+#include <log/log.h>
+#include <base/file.h>
+#include <base/strings.h>
+#include <base/file.h>
+#include <base/macros.h>
+#include <base/stringprintf.h>
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
 
 using std::string;
 
@@ -115,6 +146,7 @@ static const TracingCategory k_categories[] = {
     { "rs",         "RenderScript",             ATRACE_TAG_RS, { } },
     { "bionic",     "Bionic C Library",         ATRACE_TAG_BIONIC, { } },
     { "power",      "Power Management",         ATRACE_TAG_POWER, { } },
+#ifdef BUILD_WITH_ANDROID
     { "pm",         "Package Manager",          ATRACE_TAG_PACKAGE_MANAGER, { } },
     { "ss",         "System Server",            ATRACE_TAG_SYSTEM_SERVER, { } },
     { "database",   "Database",                 ATRACE_TAG_DATABASE, { } },
@@ -124,6 +156,7 @@ static const TracingCategory k_categories[] = {
     { "aidl",       "AIDL calls",               ATRACE_TAG_AIDL, { } },
     { "nnapi",      "NNAPI",                    ATRACE_TAG_NNAPI, { } },
     { "rro",        "Runtime Resource Overlay", ATRACE_TAG_RRO, { } },
+#endif
     { k_coreServiceCategory, "Core services", 0, { } },
     { k_pdxServiceCategory, "PDX services", 0, { } },
     { "sched",      "CPU Scheduling",   0, {
@@ -241,6 +274,7 @@ static const TracingCategory k_categories[] = {
     } },
 };
 
+#ifdef BUILD_WITH_ANDROID
 struct TracingVendorCategory {
     // The name identifying the category.
     std::string name;
@@ -257,6 +291,7 @@ struct TracingVendorCategory {
             , enabled(enabled)
     {}
 };
+#endif
 
 /* Command line options */
 static int g_traceDurationSeconds = 5;
@@ -275,8 +310,10 @@ static bool g_tracePdx = false;
 static bool g_traceAborted = false;
 static bool g_categoryEnables[arraysize(k_categories)] = {};
 static std::string g_traceFolder;
+#ifdef BUILD_WITH_ANDROID
 static sp<IAtraceDevice> g_atraceHal;
 static std::vector<TracingVendorCategory> g_vendorCategories;
+#endif
 
 /* Sys file paths */
 static const char* k_traceClockPath =
@@ -433,7 +470,16 @@ static bool setKernelOptionEnable(const char* filename, bool enable)
 static bool isCategorySupported(const TracingCategory& category)
 {
     if (strcmp(category.name, k_coreServiceCategory) == 0) {
+        #ifdef BUILD_WITH_ANDROID
         return !android::base::GetProperty(k_coreServicesProp, "").empty();
+        #else
+        char value[PROPERTY_VALUE_MAX];
+        property_get(k_coreServicesProp, value, "");
+         if (value[0] == '\0'){
+             ALOGD("error parsing prop %s",k_coreServicesProp);
+             return 0;
+         }
+        #endif
     }
 
     if (strcmp(category.name, k_pdxServiceCategory) == 0) {
@@ -490,10 +536,17 @@ static bool setTraceOverwriteEnable(bool enable)
 // Set the user initiated trace property
 static bool setUserInitiatedTraceProperty(bool enable)
 {
+    #ifdef BUILD_WITH_ANDROID
     if (!android::base::SetProperty(k_userInitiatedTraceProperty, enable ? "1" : "")) {
         fprintf(stderr, "error setting user initiated strace system property\n");
         return false;
     }
+    #else
+    if( property_set(k_userInitiatedTraceProperty,enable ? "1" : "" ) < 0){
+        fprintf(stderr, "error setting user initiated strace system property\n");
+        return false;
+    }
+    #endif
     return true;
 }
 
@@ -538,7 +591,11 @@ static bool setCmdlineSize()
 // update it if the requested value is not the current value.
 static bool setClock()
 {
+    #ifdef BUILD_WITH_ANDROID
     std::ifstream clockFile((g_traceFolder + k_traceClockPath).c_str(), O_RDONLY);
+    #else
+    std::ifstream clockFile((g_traceFolder + k_traceClockPath).c_str(),  std::ios::binary);
+    #endif
     std::string clockStr((std::istreambuf_iterator<char>(clockFile)),
         std::istreambuf_iterator<char>());
 
@@ -578,19 +635,34 @@ static bool setPrintTgidEnableIfPresent(bool enable)
 static bool setTagsProperty(uint64_t tags)
 {
     std::string value = android::base::StringPrintf("%#" PRIx64, tags);
-    if (!android::base::SetProperty(k_traceTagsProperty, value)) {
+    #ifdef BUILD_WITH_ANDROID
+      if (!android::base::SetProperty(k_traceTagsProperty, value)) {
         fprintf(stderr, "error setting trace tags system property\n");
         return false;
     }
+    #else
+    if( property_set(k_traceTagsProperty,value.c_str()) < 0){
+        fprintf(stderr, "error setting trace tags system property\n");
+        return false;
+    }
+    ALOGD("prop debug.atrace.tags.enableflags = %0x \n", tags);
+    #endif
     return true;
 }
 
 static void clearAppProperties()
 {
+     #ifdef BUILD_WITH_ANDROID
     if (!android::base::SetProperty(k_traceAppsNumberProperty, "")) {
         fprintf(stderr, "failed to clear system property: %s",
               k_traceAppsNumberProperty);
     }
+    #else
+    if( property_set(k_traceAppsNumberProperty,"") < 0){
+       fprintf(stderr, "failed to clear system property: %s",
+              k_traceAppsNumberProperty);
+    }
+    #endif
 }
 
 // Set the system property that indicates which apps should perform
@@ -606,21 +678,38 @@ static bool setAppCmdlineProperty(char* cmdline)
             end++;
         }
         std::string key = android::base::StringPrintf(k_traceAppsPropertyTemplate, i);
+        #ifdef BUILD_WITH_ANDROID
         if (!android::base::SetProperty(key, start)) {
             fprintf(stderr, "error setting trace app %d property to %s\n", i, key.c_str());
             clearAppProperties();
             return false;
         }
+        #else
+        if( property_set(key.c_str(), start) < 0){
+           fprintf(stderr, "error setting trace app %d property to %s\n", i, key);
+            clearAppProperties();
+            return false;
+        }
+
+        #endif
         start = end;
         i++;
     }
 
     std::string value = android::base::StringPrintf("%d", i);
+    #ifdef BUILD_WITH_ANDROID
     if (!android::base::SetProperty(k_traceAppsNumberProperty, value)) {
         fprintf(stderr, "error setting trace app number property to %s\n", value.c_str());
         clearAppProperties();
         return false;
     }
+    #else
+    if( property_set(k_traceAppsNumberProperty, value.c_str()) < 0){
+        fprintf(stderr, "error setting trace app %d property to %s\n", i, value);
+        clearAppProperties();
+        return false;
+    }
+    #endif
     return true;
 }
 
@@ -650,7 +739,7 @@ static bool verifyKernelTraceFuncs(const char* funcs)
          return false;
     }
 
-    String8 funcList = String8::format("\n%s",buf.c_str());
+    android::String8 funcList = android::String8::format("\n%s",buf.c_str());
 
     // Make sure that every function listed in funcs is in the list we just
     // read from the kernel, except for wildcard inputs.
@@ -659,7 +748,7 @@ static bool verifyKernelTraceFuncs(const char* funcs)
     char* func = strtok(myFuncs, ",");
     while (func) {
         if (!strchr(func, '*')) {
-            String8 fancyFunc = String8::format("\n%s\n", func);
+            android::String8 fancyFunc = android::String8::format("\n%s\n", func);
             bool found = funcList.find(fancyFunc.string(), 0) >= 0;
             if (!found || func[0] == '\0') {
                 fprintf(stderr, "error: \"%s\" is not a valid kernel function "
@@ -716,12 +805,14 @@ static bool setKernelTraceFuncs(const char* funcs)
 static bool setCategoryEnable(const char* name)
 {
     bool vendor_found = false;
+    #ifdef BUILD_WITH_ANDROID
     for (auto &c : g_vendorCategories) {
         if (strcmp(name, c.name.c_str()) == 0) {
             c.enabled = true;
             vendor_found = true;
         }
     }
+    #endif
     for (size_t i = 0; i < arraysize(k_categories); i++) {
         const TracingCategory& c = k_categories[i];
         if (strcmp(name, c.name) == 0) {
@@ -752,13 +843,13 @@ static bool setCategoriesEnableFromFile(const char* categories_file)
     if (!categories_file) {
         return true;
     }
-    Tokenizer* tokenizer = nullptr;
-    if (Tokenizer::open(String8(categories_file), &tokenizer) != NO_ERROR) {
+    android::Tokenizer* tokenizer = nullptr;
+    if (android::Tokenizer::open(android::String8(categories_file), &tokenizer) != android::NO_ERROR) {
         return false;
     }
     bool ok = true;
     while (!tokenizer->isEol()) {
-        String8 token = tokenizer->nextToken(" ");
+        android::String8 token = tokenizer->nextToken(" ");
         if (token.isEmpty()) {
             tokenizer->skipDelimiters(" ");
             continue;
@@ -799,13 +890,21 @@ static bool setUpUserspaceTracing()
         if (!packageList.empty()) {
             packageList += ",";
         }
+        #ifdef BUILD_WITH_ANDROID
         packageList += android::base::GetProperty(k_coreServicesProp, "");
+        #else
+        char value[PROPERTY_VALUE_MAX];
+        property_get(k_coreServicesProp, value, "");
+        packageList += value;
+        #endif
     }
     ok &= setAppCmdlineProperty(&packageList[0]);
     ok &= setTagsProperty(tags);
+    #ifdef BUILD_WITH_ANDROID
     if (g_tracePdx) {
         ok &= ServiceUtility::PokeServices();
     }
+    #endif
 
     return ok;
 }
@@ -814,10 +913,11 @@ static void cleanUpUserspaceTracing()
 {
     setTagsProperty(0);
     clearAppProperties();
-
+    #ifdef BUILD_WITH_ANDROID
     if (g_tracePdx) {
         ServiceUtility::PokeServices();
     }
+    #endif
 }
 
 
@@ -852,6 +952,7 @@ static bool setUpKernelTracing()
                 bool required = c.sysfiles[j].required == REQ;
                 if (path != nullptr) {
                     if (fileIsWritable(path)) {
+                        ALOGD("Setting enable as 1 for node %s \n", path);
                         ok &= setKernelOptionEnable(path, true);
                     } else if (required) {
                         fprintf(stderr, "error writing file %s\n", path);
@@ -1047,9 +1148,11 @@ static void listSupportedCategories()
             printf("  %10s - %s\n", c.name, c.longname);
         }
     }
+    #ifdef BUILD_WITH_ANDROID
     for (const auto &c : g_vendorCategories) {
         printf("  %10s - %s (HAL)\n", c.name.c_str(), c.description.c_str());
     }
+    #endif
 }
 
 // Print the command usage help to stderr.
@@ -1105,6 +1208,7 @@ bool findTraceFiles()
 
     return true;
 }
+#ifdef BUILD_WITH_ANDROID
 
 void initVendorCategories()
 {
@@ -1178,6 +1282,7 @@ static bool cleanUpVendorTracing()
     }
     return true;
 }
+#endif
 
 int main(int argc, char **argv)
 {
@@ -1198,7 +1303,9 @@ int main(int argc, char **argv)
         exit(-1);
     }
 
+#ifdef BUILD_WITH_ANDROID
     initVendorCategories();
+#endif
 
     for (;;) {
         int ret;
@@ -1320,8 +1427,12 @@ int main(int argc, char **argv)
     }
 
     if (ok && traceStart && !onlyUserspace) {
+        ALOGD("Setting up kernel tracing\n");
         ok &= setUpKernelTracing();
+        #ifdef BUILD_WITH_ANDROID
         ok &= setUpVendorTracing();
+        #endif
+        ALOGD("Starting trace \n");
         ok &= startTrace();
     }
 
@@ -1392,10 +1503,15 @@ int main(int argc, char **argv)
     if (traceStop) {
         cleanUpUserspaceTracing();
         if (!onlyUserspace) {
+            #ifdef BUILD_WITH_ANDROID
             cleanUpVendorTracing();
+            #endif
             cleanUpKernelTracing();
         }
     }
 
     return g_traceAborted ? 1 : 0;
 }
+#ifdef __cplusplus
+}
+#endif
--
2.17.1

