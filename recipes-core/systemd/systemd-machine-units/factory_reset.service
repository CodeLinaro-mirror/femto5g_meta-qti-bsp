[Unit]
Description=Factory Reset Userdata
DefaultDependencies=no

After=early-mount.service
RequiresMountsFor=/persist

Before=overlay.mount data.mount wlan_pre_load.service

ConditionPathExists=/persist/factory_reset.flag

[Service]
Type=oneshot
ExecStart=/usr/bin/factory_reset.sh

[Install]
WantedBy=local-fs.target
