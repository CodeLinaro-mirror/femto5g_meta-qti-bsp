[Unit]
Description=Mount overlayfs on /cache
DefaultDependencies=no
After=overlay-workdir.service
Before=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
SELinuxContext=system_u:system_r:overlay_cache_mounter_t:s0
ExecStart=/usr/libexec/overlay-mounter cache

[Install]
WantedBy=local-fs.target
