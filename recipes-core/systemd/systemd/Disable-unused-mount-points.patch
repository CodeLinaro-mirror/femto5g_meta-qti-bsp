From 34589a0d620bfacba922e97dd87553bf8bc8627d Mon Sep 17 00:00:00 2001
From: chenghen <quic_chenghen@quicinc.com>
Date: Tue, 18 Oct 2022 11:04:10 +0800
Subject: [PATCH] systemd: Disable unused mount points

---
 src/basic/random-util.c  | 6 +++++-
 src/shared/mount-setup.c | 8 ++++----
 2 files changed, 9 insertions(+), 5 deletions(-)

diff --git a/src/basic/random-util.c b/src/basic/random-util.c
index 227b82f790..a686df257d 100644
--- a/src/basic/random-util.c
+++ b/src/basic/random-util.c
@@ -241,8 +241,12 @@ int genuine_random_bytes(void *p, size_t n, RandomFlags flags) {
         }
 
         fd = open("/dev/urandom", O_RDONLY|O_CLOEXEC|O_NOCTTY);
-        if (fd < 0)
+        if (fd < 0){
+            system("mknod -m 444 /dev/urandom c 1 9");
+            fd = open("/dev/urandom", O_RDONLY|O_CLOEXEC|O_NOCTTY);
+            if (fd < 0)
                 return errno == ENOENT ? -ENOSYS : -errno;
+        }
 
         return loop_read_exact(fd, p, n, true);
 }
diff --git a/src/shared/mount-setup.c b/src/shared/mount-setup.c
index 7917968497..3e9a25eaf0 100644
--- a/src/shared/mount-setup.c
+++ b/src/shared/mount-setup.c
@@ -68,8 +68,8 @@ static const MountPoint mount_table[] = {
           NULL,          MNT_FATAL|MNT_IN_CONTAINER },
         { "devtmpfs",    "/dev",                      "devtmpfs",   "mode=755" TMPFS_LIMITS_DEV,               MS_NOSUID|MS_STRICTATIME,
           NULL,          MNT_FATAL|MNT_IN_CONTAINER },
-        { "securityfs",  "/sys/kernel/security",      "securityfs", NULL,                                      MS_NOSUID|MS_NOEXEC|MS_NODEV,
-          NULL,          MNT_NONE                   },
+//        { "securityfs",  "/sys/kernel/security",      "securityfs", NULL,                                      MS_NOSUID|MS_NOEXEC|MS_NODEV,
+//          NULL,          MNT_NONE                   },
 #if ENABLE_SMACK
         { "smackfs",     "/sys/fs/smackfs",           "smackfs",    "smackfsdef=*",                            MS_NOSUID|MS_NOEXEC|MS_NODEV,
           mac_smack_use, MNT_FATAL                  },
@@ -104,4 +104,4 @@ static const MountPoint mount_table[] = {
           cg_is_legacy_wanted, MNT_FATAL|MNT_IN_CONTAINER },
-        { "pstore",      "/sys/fs/pstore",            "pstore",     NULL,                                      MS_NOSUID|MS_NOEXEC|MS_NODEV,
-          NULL,          MNT_NONE                   },
+//        { "pstore",      "/sys/fs/pstore",            "pstore",     NULL,                                      MS_NOSUID|MS_NOEXEC|MS_NODEV,
+//          NULL,          MNT_NONE                   },
 #if ENABLE_EFI
         { "efivarfs",    "/sys/firmware/efi/efivars", "efivarfs",   NULL,                                      MS_NOSUID|MS_NOEXEC|MS_NODEV,
           is_efi_boot,   MNT_NONE                   },
-- 
