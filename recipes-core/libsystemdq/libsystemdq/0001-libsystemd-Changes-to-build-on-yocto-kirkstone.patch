From ee15d96da6cd3421ecd80e5e0273b1873aebae2e Mon Sep 17 00:00:00 2001
From: Keerthi Gowda Balehalli Satyanarayana <quic_kbalehal@quicinc.com>
Date: Fri, 10 Nov 2023 15:37:23 -0800
Subject: [PATCH] libsystemd: Changes to build on yocto kirkstone

Upstream-Status: Inappropriate [downstream Yocto build compatibility]

---
 meson.build              | 2 +-
 src/basic/linux/if_arp.h | 1 +
 src/basic/meson.build    | 1 -
 3 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/meson.build b/meson.build
index 1bdb9c7b32..48d18d8c84 100644
--- a/meson.build
+++ b/meson.build
@@ -38,7 +38,7 @@ conf.set_quoted('RELATIVE_SOURCE_PATH', relative_source_path)
 want_ossfuzz = get_option('oss-fuzz')
 want_libfuzzer = get_option('llvm-fuzz')
 want_fuzzbuzz = get_option('fuzzbuzz')
-if want_ossfuzz + want_libfuzzer + want_fuzzbuzz > 1
+if want_ossfuzz and want_libfuzzer and want_fuzzbuzz > 1
         error('only one of oss-fuzz, llvm-fuzz or fuzzbuzz can be specified')
 endif
 
diff --git a/src/basic/linux/if_arp.h b/src/basic/linux/if_arp.h
index c3cc5a9e5e..4783af9fe5 100644
--- a/src/basic/linux/if_arp.h
+++ b/src/basic/linux/if_arp.h
@@ -54,6 +54,7 @@
 #define ARPHRD_X25	271		/* CCITT X.25			*/
 #define ARPHRD_HWX25	272		/* Boards with X.25 in firmware	*/
 #define ARPHRD_CAN	280		/* Controller Area Network      */
+#define ARPHRD_MCTP	290
 #define ARPHRD_PPP	512
 #define ARPHRD_CISCO	513		/* Cisco HDLC	 		*/
 #define ARPHRD_HDLC	ARPHRD_CISCO
diff --git a/src/basic/meson.build b/src/basic/meson.build
index f70d1b8bf8..aa9aa5fe35 100644
--- a/src/basic/meson.build
+++ b/src/basic/meson.build
@@ -94,7 +94,6 @@ basic_sources = files('''
         linux/fou.h
         linux/if.h
         linux/if_addr.h
-        linux/if_arp.h
         linux/if_bonding.h
         linux/if_bridge.h
         linux/if_ether.h
-- 
2.17.1
