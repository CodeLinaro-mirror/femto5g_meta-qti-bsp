[Unit]
Description=Init-graphics Service
SourcePath=/usr/sbin/initscripts/init_qti_graphics
Requires=leprop.service
After=leprop.service
[Service]
User=graphics
Group=graphics
Restart=no
Type=oneshot
RemainAfterExit=no
ExecStart=+/usr/sbin/initscripts/init_qti_graphics
ExecStop=+/usr/sbin/initscripts/init_qti_graphics

[Install]
WantedBy=multi-user.target
