lxc.uts.name = lv

lxc.rootfs.path = /vendor_early_services/vendor/vm-system

# Android host will cover the PATH environment of container
lxc.environment = PATH=$PATH:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

lxc.init.cmd = /lib/systemd/systemd systemd.log_level=debug systemd.log_target=console systemd.unified_cgroup_hierarchy=0

lxc.console.logfile = /vendor_early_services/run/lxc_console.log
# The log lives in tmpfs: once it reaches 512KB it is truncated and rewritten
# from the start, no backup is kept (rename is denied by sepolicy)
lxc.console.size = 512KB
#lxc.selinux.context = u:r:kernel:s0
#lxc.start.auto = 1

lxc.autodev = 1

lxc.seccomp.profile = /vendor_early_services/vendor/vm-system/lxc/lxc-conf/lv/seccomp.conf

# CGroup whitelist
#lxc.cgroup2.devices.allow = a
lxc.cgroup.devices.allow = a
## Allow any mknod (but not reading/writing the node)
lxc.cgroup.devices.allow = c *:* m
lxc.cgroup.devices.allow = b *:* m


lxc.signal.halt = SIGKILL
# android will failed if mount /proc failed
lxc.mount.auto = proc:mixed sys:mixed cgroup:mixed

# lxc.mount.entry = /tmp share/socket/camera none bind,create=dir 0 0
lxc.mount.entry = /vendor_early_services/vendor/lxc-data data none bind,create=dir 0 0
#lxc.mount.entry = /dev/tty50 dev/console none bind,create=file 0 0
lxc.mount.entry = /sys/fs/selinux sys/fs/selinux none bind,create=dir 0 0
lxc.mount.entry = /dev/dma_heap dev/dma_heap none bind,create=dir 0 0
lxc.mount.entry = /dev/dri/renderD128 dev/dri/renderD128 none bind,create=file 0 0
lxc.mount.entry = /dev/dri/card2 dev/dri/card0 none bind,create=file 0 0
lxc.mount.entry = /dev/snd dev/snd none bind,optional,create=dir
lxc.mount.entry = /dev/socket/agm dev/socket/agm none bind,create=dir 0 0
lxc.mount.entry = /dev/kgsl-3d0 dev/kgsl-3d0 none bind,create=file 0 0

# /dev/null, /dev/zero, /dev/full, /dev/random, /dev/urandom
lxc.cgroup.devices.allow = c 1:3 rwm
lxc.cgroup.devices.allow = c 1:5 rwm
lxc.cgroup.devices.allow = c 1:7 rwm
lxc.cgroup.devices.allow = c 1:8 rwm
lxc.cgroup.devices.allow = c 1:9 rwm
lxc.cgroup.devices.allow = c 1:9 rwm

# /dev/tty, /dev/console, /dev/ptmx
lxc.cgroup.devices.allow = c 5:0 rwm
lxc.cgroup.devices.allow = c 5:1 rwm
lxc.cgroup.devices.allow = c 5:2 rwm
lxc.cgroup.devices.allow = c 1:11 rwm

# /dev/pts/*
lxc.cgroup.devices.allow = c 136:* rwm

# Cgroup configuration
lxc.cgroup.devices.deny                = c 226:0 m
lxc.cgroup.devices.deny                = c 226:1 m
lxc.cgroup.devices.allow               = c 226:2 rwm
lxc.cgroup.devices.deny                = c 226:3 m
lxc.cgroup.devices.allow               = c 226:128 rwm

# Set memory.max
lxc.cgroup2.memory.max                  = 1536M
# Affinity to middle core 3,4, small core 0,1,2
lxc.cgroup.cpuset.cpus                 = 0,1,2,3,4

# Disable console in android container
#lxc.cgroup.devices.deny = /dev/console rwm

# Network
lxc.net.0.type = veth
lxc.net.0.hwaddr = aa:aa:aa:aa:ee:03
lxc.net.0.flags = up
lxc.net.0.link = lxcbr0
lxc.net.0.ipv4.address = 192.168.1.3/24
lxc.net.0.ipv4.gateway = 192.168.1.10

